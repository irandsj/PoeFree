<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PoeFree.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <!-- PoE stone + bronze, with green replacing the game's red-orange accent -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark"
                               Accent="#2F8040"
                               AltHigh="#0B0C09" AltLow="#0B0C09" AltMedium="#0B0C09" AltMediumHigh="#0B0C09" AltMediumLow="#0B0C09"
                               BaseHigh="#EDE6CF" BaseMediumHigh="#C9C2AE" BaseMedium="#A79F87" BaseMediumLow="#6E6754" BaseLow="#3A3427"
                               ChromeAltLow="#C9C2AE" ChromeBlackHigh="#000000" ChromeBlackLow="#C9C2AE" ChromeBlackMedium="#000000" ChromeBlackMediumLow="#000000"
                               ChromeDisabledHigh="#3A3427" ChromeDisabledLow="#6E6754" ChromeGray="#8A8470" ChromeHigh="#5E4E31"
                               ChromeLow="#12140F" ChromeMedium="#181B14" ChromeMediumLow="#1E2219" ChromeWhite="#FFFFFF"
                               ListLow="#16190F" ListMedium="#2B261A"
                               RegionColor="#0B0C09" ErrorText="#D2554A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    <StyleInclude Source="/Themes/PoeTheme.axaml" />
  </Application.Styles>
</Application>
