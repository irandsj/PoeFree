<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PoeFree.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

    <Style Selector="Window">
      <Setter Property="Background" Value="#16191D" />
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#4EC9B0" />
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9AA8B5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#1E2227" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#5C4A1E" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#1E8A5E" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#25A672" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#2C3A34" />
      <Setter Property="Foreground" Value="#7E8790" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style Selector="TabControl > TabItem">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
  </Application.Styles>
</Application>
